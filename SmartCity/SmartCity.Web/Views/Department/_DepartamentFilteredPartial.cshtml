@using SmartCity.Domain
@using SmartCity.Domain.Extensions
@using SmartCity.Web.Models.Departament
@model IPagedList<DepartamentFilteredViewModel>


<div class="sc-info-table-container">

    <div class="m-3">
        <partial name="_PaginationWithParamsAndCount" />
    </div>

    <div class="table-wrapper">
        <table class="table table-hover table-responsive table-sm sc-table">
            <thead>
                <tr class="text-xsmall wheight600 text-center-ic">
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th>Teams</th>
                    <th scope="col">CreatedAt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="text-xxsmall wheight400 text-center-ic text-center-ic">
                        <th scope="row">@(Model.PagedIndexOf(item))</th>
                        <td>@item.Name</td>
                        <td>@item.TeamsCount</td>
                        <td>@item.CreatedAt.ToFullPrintDate()</td>
                        <td>
                            <a href="@Url.Action("Departamentinfo", "Department", new {Id = item.Id} )" class="info-table-view clear-decoration" target="_blank">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />


</div>