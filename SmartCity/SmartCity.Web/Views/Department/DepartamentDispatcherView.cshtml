@using SmartCity.Web.Models.Departament
@model GanttViewModel

<link rel="stylesheet" href="~/css/DepartmentPage.css" asp-append-version="true" />


<div class="sc-dep-grantt-page-container">
    <div class="mb-3">
        <button class="sc-general-btn home-tab-btn text-small" id="showTrashDepartmentGrantt">Salubritate</button>
        <button class="sc-general-btn home-tab-btn ms-4 text-small" id="showRoadInfrastructureGrantt" style="width: 210px">Infrastructura rutiera</button>
        <button class="sc-general-btn home-tab-btn ms-4 text-small" id="showPublicDomainGrantt">Spatii verzi</button>

        <form asp-controller="Department" asp-action="Gantt" method="post" autocomplete="off" id="form-create-guarantees-offer" class="department-form d-flex-ic center-flex-align">
            <div class="text-large wheight600">Timeline</div>
            <div class="">
                <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="BeginDate" hidden>De la</label>
                <input asp-for="BeginDate" type="date" class="form-control sc-custom-inputs form-input sc-sm-width sc-sm-height" style="height:30px; max-height:30px">
            </div>
            <div class="">
                <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="EndDate" hidden>De la</label>
                <input asp-for="EndDate" type="date" class="form-control sc-custom-inputs form-input sc-sm-width sc-sm-height" style="height:30px; max-height:30px">
            </div>

            <button type="submit" class="sc-general-btn ic-active text-small sc-sm-width" style="height:30px">Caută</button>
        </form>
    </div>
    <div class="mb-3">
        <div id="taskInfoContainer"></div>
    </div>
    <partial name="_DepartamentGranttViewPartial" model="Model" />

