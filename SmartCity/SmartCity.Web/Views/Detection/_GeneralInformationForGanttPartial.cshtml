<div class="detection-card">
  <div class="detection-card__top">
    <span class="pill pill--dept">
      <span class="pill__chev">Departament: </span>
      @Model.DepartamentName
    </span>

    <span class="pill pill--team">
      <span class="pill__chev">Echipa: </span>
      @Model.TeamName
    </span>

        <span class="rawDetectionImgContainer field" data-id="@Model.RawDataId">
            <img class="preview-img" data-id="@Model.RawDataId"
                 src="~/Assets/Images/photoPlaceholder.png"
                 style="max-width:100%; max-height:40px; border-radius: 12px;min-width:22px;max-width:222px;"
                 onerror="this.onerror=null;this.src='~/Assets/Images/photoPlaceholder.png" />
        </span>
  </div>

  <div class="detection-card__grid">


    <div class="field">
      <span class="field__label">Categorie</span>
      <p class="field__value">@Model.Category.Description()</p>
    </div>

    <div class="field">
      <span class="field__label">Descriere</span>
      <p class="field__value">@Model.Description</p>
    </div>

    <div class="field">
      <span class="field__label">Grad de periculozitate</span>
            <p class="text-center-ic text-xsmall wheight400 @severityClass" style="margin:0">@Model.Severity.Description()</p>
    </div>

    <div class="field">
      <span class="field__label">Status rezolvare</span>
            <p class="text-center-ic text-xsmall wheight400 @resolutionClass" style="margin:0; max-width:fit-content">@Model.ResolutionStatus.Description()</p>
    </div>

    <div class="field">
      <span class="field__label">Data raportării</span>
      <p class="field__value">@Model.ReportingDate</p>
    </div>
  </div>
</div>

