@using SmartCity.Domain.Extensions
@using SmartCity.Web.Models.Detection
@model DetectionViewModel

@{
    string severityClass = Model.Severity.Description() switch
    {
        "Medie" => "severity-class medium-severity",
        "Remediata" => "severity-class repaired-severity",
        "Scazuta" => "severity-class small-severity",
        "Critica" => "severity-class critical-severity",
        "Ridicata" => "severity-class bigger-severity",
        _ => ""
    };
    }

@{
    string resolutionClass = Model.ResolutionStatus.Description() switch
    {
        "Raportată" => "severity-class medium-severity",
        "Rezolvată" => "severity-class repaired-severity",
        "In curs de rezolvare" => "severity-class small-severity",
        _ => ""
    };
}

@{
    string needInterventionClass = Model.NeedIntervention.Description() switch
    {
        "Da" => "severity-class yes-severity",
        "Nu" => "severity-class no-severity",
        _ => ""
    };
}

