@using SmartCity.Web.Models.Home
@model HomeModel

@{
    ViewData["Title"] = "Home Page";
}


<link rel="stylesheet" href="~/css/HomePage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Components/Tables.css" asp-append-version="true" />
<input id="rawDataId" type="hidden" />
<div class="images-container center-flex flex-column" id="tab2-picture">
    <button type="button" class="sc-general-btn ic-active text-small sc-sm-width" style="position: relative;top: 40px;right: -15%;">
        Close
    </button>
    <img id="detectionImg" src="">
</div>
<div class="sc-home-page-container">   
    <div>
        <partial name="DetectionFilter" model="@Model.DetectionFilterModel" />
    </div>
    <div class="sc-home-middle-container row">
        <div class="col-md-6">
            <div class="pagination-results filter-pagination w-100-ic" data-filter-id="#docs-filter" data-filter-on-load="true">
            </div>
        </div>

        <div class="col-md-6 sc-data-container">
            <div class="row sc-map-container">
                <div id="map" class="info-map-container">
                </div>
            </div>
            <div class="row sc-data-insert-container">
                <div>
                    <div class="flow-container" id="sc-flow-container">
                        <div class="w-100-ic h-100-ic center-flex flex-column">
                            <div class="text-large m-w-80-ic text-center-ic">
                                Selecteaza o detectie din tabel pentru a o atribui departamentului catre rezolvare
                            </div>             
                        </div>  
                    </div>

                    <div id="sc-chat-container"></div>
                </div>
            </div>
        </div>


    </div>

