@using SmartCity.Domain
@using SmartCity.Web.Models.UserManagement
@model IPagedList<UserModel>

@{
    string GetEnabledColor(bool enabled)
    {

        if (enabled) return "success";
        else
            return "danger";


    }

}
<div class="sc-info-table-container">
    <div class="m-5">
        <partial name="_PaginationWithParamsAndCount" />
    </div>

    <div class="sc-home table-wrapper sc-user">

        <table class="table table-hover table-responsive table-sm sc-table">
            <thead>
                <tr class="text-xsmall wheight600">
                    <th scope="col">#</th>
                    <th scope="col">UserName</th>
                    <th scope="col">FirstName</th>
                    <th scope="col">LastName</th>
                    <th scope="col">Email</th>
                    <th scope="col">PhoneNumber</th>
                    <th scope="col">TwoFactorEnabled</th>
                    <th scope="col">LockoutEnabled</th>
                    <th scope="col">LockoutEnd</th>
                    <th scope="col">CreatedAt</th>
                    <th scope="col">UpdatedAt</th>
                    <th scope="col">Enabled</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="text-xxsmall wheight400 text-center-ic">
                        <th scope="row">@(Model.PagedIndexOf(user))</th>
                        <td>
                            <a href="@Url.Action("EditUser", "UserManagement", new {Id = user.Id} )" target="_blank" aria-pressed="true">
                                @user.UserName
                            </a>
                        </td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>@user.TwoFactorEnabled</td>
                        <td>@user.LockoutEnabled</td>
                        <td>@user.LockoutEnd</td>
                        <td>@user.CreatedAt</td>
                        <td>@user.UpdatedAt</td>
                        <td>
                            <span class="badge badge-@(GetEnabledColor(@user.Enabled))">@user.Enabled</span>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" />

</div>
