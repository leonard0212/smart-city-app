@using SmartCity.Web.Models.UserManagement
@model CreateUserModel
<link rel="stylesheet" href="~/css/UserPage.css" asp-append-version="true" />

<div class="sc-user-container center-flex flex-column">
    <h2 class="text-xxlarge28 wheight500 mb-5">Crează un user nou</h2>
    <form asp-controller="Usermanagement" asp-action="CreateUser" method="post" autocomplete="off" id="form-create-guarantees-offer">

        <div class="form-group col sc-lg-width">
            <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="Email"></label>
            <input asp-for="Email" type="email" class="form-control sc-custom-inputs form-input sc-lg-width mt-2" />
            <span asp-validation-for="Email" class=""></span>
        </div>
        <div class="form-group col sc-lg-width mt-3">
            <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control sc-custom-inputs form-input sc-lg-width mt-2" />
            <span asp-validation-for="FirstName" class=""></span>
        </div>
        <div class="form-group col sc-lg-width mt-3">
            <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control sc-custom-inputs form-input sc-lg-width mt-2" />
            <span asp-validation-for="LastName" class=""></span>
        </div>

        <div class="form-group col sc-lg-width mt-3">
            <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="Password"></label>
            <input asp-for="Password" type="password" class="form-control sc-custom-inputs form-input sc-lg-width mt-2" />
            <span asp-validation-for="Password" class=""></span>
        </div>
        <div class="form-group col sc-lg-width mt-3">
            <label class="control-label px-2 mb-2 text-xsmall wheight400" asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control sc-custom-inputs form-input sc-lg-width mt-2" />
            <span asp-validation-for="ConfirmPassword" class=""></span>
        </div>

        <button type="submit" class="sc-general-btn ic-active text-small sc-lg-width mt-5" style="height:35px">Create</button>
    </form>
</div>
