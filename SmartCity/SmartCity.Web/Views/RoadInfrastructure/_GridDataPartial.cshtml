@using SmartCity.Domain.Extensions
@using SmartCity.Domain.Models.Enums
@using SmartCity.Web.Models.RoadInfrastructure
@model List<RoadInfrastructureDataModel>

@{

    string GetSeverityColor(SeverityType severity)
    {
        switch (severity)
        {
            case SeverityType.Medium:
                return "severity-class medium-severity";
            case SeverityType.None:
                return "severity-class repaired-severity";
            case SeverityType.Low:
                return "severity-class small-severity";
            case SeverityType.Critical:
                return "severity-class critical-severity";
            case SeverityType.High:
                return "severity-class bigger-severity";

            default:
                return "primary";

        }
    }
}



<div class="sc-info-table-container">
    <div class="mb-3">
        <span class="text-small wheight600 me-4">Interval</span>
        <input type="date" class="sc-input date-select" id="startDateRoadInfrastructure" />
        <input type="date" class="sc-input date-select" id="endDateRoadInfrastructure" />
    </div>

    <div>
        <p class="text-small wheight600">Probleme semnalate</p>
        <div class="table-wrapper">
            <table class="table table-hover table-responsive table-sm sc-table">
                <thead>
                    <tr class="text-xsmall wheight600 text-center-ic">
                        <th scope="col">#</th>
                        <th scope="col">Categorie</th>
                        <th scope="col">Gravitatea problemei</th>
                        <th scope="col">Data</th>
                        <th scope="col"> </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="text-xxsmall wheight400 text-center-ic">
                            <th scope="row">@(Model.IndexOf(item) + 1)</th>
                            <td>@item.Type.Description()</td>
                            <td>
                                 
                                <div class="@GetSeverityColor(item.Severity)">
                                    @item.Severity.Description()
                                </div>

                            </td>
                            <td>@item.ReportingDate?.ToString("dd.MM.yyyy")</td>
                            <td><button type="button" class="info-table-view clear-decoration grid-view-btn" data-id="@item.Id"><i class="fa-regular fa-eye"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<script>
    const currentDate = new Date().toISOString().split("T")[0];

    document.getElementById("startDateRoadInfrastructure").value = currentDate;
    document.getElementById("endDateRoadInfrastructure").value = currentDate;
</script>
