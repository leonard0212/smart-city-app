        @if (isDispatcher || isAdmin)
        {
            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
            @(currentController == "Home" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="sideBar-icon center-flex">
                        <img src="~/Assets/Icons/raportari.svg" />
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Raportari</div>
                </a>
            </li>

            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
        @(currentController == "Department" && currentAction == "Gantt" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-controller="Department" asp-action="Gantt">
                    <div class="sideBar-icon center-flex">
                        <img src="~/Assets/Icons/departamente.svg" />
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Departamente</div>
                </a>
            </li>

            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
         @(currentController == "Analytics" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="Analytics" asp-action="Index">
                    <div class="sideBar-icon center-flex">
                        <img src="~/Assets/Icons/analiza.svg" />
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Analiza</div>
                </a>
            </li>

            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
         @(currentController == "Message" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="Message" asp-action="Index">
                    <div class="sideBar-icon center-flex">
                        <img src="~/Assets/Icons/mesaje.svg" />
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Mesaje</div>
                </a>
            </li>


            <li id="adminSubMenu" class="slideBar-item-container sc-slideBar center-flex-align mb-4
            @(currentController == "Admin" || (currentController == "Department" && currentAction == "Index") || currentController == "UserManagement"
                                                                                                                                    ? "slideBar-ic-active" : "")">
            <a class="slideBar-item sc-slideBar text-regular w-100">
                <div class="sideBar-icon center-flex">
                    <i class="fa-solid fa-user-gear sc-slideBar color-white text-large text-center-ic"></i>
                </div>
                <div class="sidebar-item-text slideBar-active text-small">Admin</div>
            </a>
        </li>

            <div class="admin-submenu-container @((currentController == "Admin" || currentController == "Department" && currentAction != "Gantt" || currentController == "UserManagement") ? "sub-menu-active" : "")" id="adminSubmenuContainer">
            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4 @(currentController == "Admin" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="Admin" asp-action="RawDetectionsToProcess">
                    <div class="sideBar-icon center-flex">
                        <i class="fa-solid fa-user-gear sc-slideBar color-white text-large text-center-ic"></i>
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Detectări</div>
                </a>
            </li>
            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
                    @(currentController == "UserManagement" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="UserManagement" asp-action="Index">
                    <div class="sideBar-icon center-flex">
                        <i class="fa-solid fa-user-gear sc-slideBar color-white text-large text-center-ic"></i>
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">User</div>
                </a>
            </li>
            <li class="slideBar-item-container sc-slideBar center-flex-align mb-4
                        @(currentController == "Department" && currentAction != "Gantt" ? "slideBar-ic-active" : "")">
                <a class="slideBar-item sc-slideBar text-regular w-100" asp-area="" asp-controller="Department" asp-action="Index">
                    <div class="sideBar-icon center-flex">
                        <i class="fa-solid fa-user-gear sc-slideBar color-white text-large text-center-ic"></i>
                    </div>
                    <div class="sidebar-item-text slideBar-active text-small">Departamente Edit</div>
                </a>
            </li>
            </div>

                }



