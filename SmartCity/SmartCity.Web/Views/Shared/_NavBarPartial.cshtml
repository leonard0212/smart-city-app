<link rel="stylesheet" href="~/css/Components/NavBar.css" asp-append-version="true" />

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayText = "";

    switch (currentController)
    {
        case "RoadInfrastructure":
            displayText = "Infrastructură rutieră";
            break;
        case "Salubritate":
            displayText = "Salubritate";
            break;
        case "PanouriPublicitare":
            displayText = "Panouri publicitare";
            break;
        case "SpațiiVerzi":
            displayText = "Spații verzi";
            break;
        default:
            displayText = "";
            break;
    }
}

<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container-fluid center-flex-justify-between">
        <div id="sidebarCollapse">
            <i class="fa-solid fa-list-ul color-primary-project text-xlarge px-5"></i>
            <a class="navbar-brand color-primary-text " href="#"><bold>SmartCity</bold></a>
            <span class="color-primary-text text-regular  text-italic-ic">@displayText</span>
        </div>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
    
        <div class="center-flex">
            <div>
                <i class="fa-regular fa-bell text-xxlarge28 color-primary-text m-5"></i>

            </div>
            <div class="collapse navbar-collapse" id="navbarNavDropdown">
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <div class="user-initial-navbar background-color-primary-project center-flex">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-identity text-large22">
                                    @(User.Identity.Name != null && User.Identity.Name.Length > 0
                                        ? char.ToUpper(User.Identity.Name[0])
                                        : 'N')
                                </span>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">                             
                                <li class="color-primary-text text-smal">
                                    <form action="/Authentication/LogOff" method="post" class="d-inline">
                                        @Html.AntiForgeryToken() <!-- Include anti-forgery token -->
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</nav>