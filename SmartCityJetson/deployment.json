{
  "modulesContent": {
    "$edgeAgent": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "runtime": {
          "type": "docker",
          "settings": {
            "minDockerVersion": "19.03",
            "loggingOptions": "",
            "registryCredentials": {
              "acrsmartcityjetson": {
                "address": "acrsmartcityjetson.azurecr.io",
                "username": "***",
                "password": "***"
              }
            }
          }
        },
        "systemModules": {
          "edgeAgent": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-agent:1.1",
              "createOptions": "{\"NetworkMode\":\"azure-iot-edge\"}"
            }
          },
          "edgeHub": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-hub:1.1",
              "createOptions": "{\"NetworkMode\":\"azure-iot-edge\"}"
            },
            "status": "running",
            "restartPolicy": "always"
          }
        },
        "modules": {
          "smartcity": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "acrsmartcityjetson.azurecr.io/smartcity:prod",
              "createOptions": "{\"HostConfig\":{\"Privileged\":true,\"GroupAdd\":[\"dialout\",\"video\"],\"NetworkMode\":\"azure-iot-edge\",\"Binds\":[\"/dev/dri:/dev/dri\",\"/etc/smartcity:/etc/smartcity:ro\",\"/dev/video0:/dev/video0\"]},\"Devices\":[{\"PathOnHost\":\"/dev/video0\",\"PathInContainer\":\"/dev/video0\",\"CgroupPermissions\":\"rwm\"},{\"PathOnHost\":\"/dev/ttyTHS1\",\"PathInContainer\":\"/dev/ttyTHS1\",\"CgroupPermissions\":\"rwm\"},{\"PathOnHost\":\"/dev/gpiochip0\",\"PathInContainer\":\"/dev/gpiochip0\",\"CgroupPermissions\":\"rwm\"}]}"
            },
            "env": {
              "EGL_PLATFORM": {
                "value": "surfaceless"
              },

              "START_TIME": { "value": "08:00" },
              "END_TIME":   { "value": "17:00" },
              "TZ_RO":      { "value": "EET-2EEST,M3.5.0/3,M10.5.0/4" }
            }
          }
        }
      }
    },
    "$edgeHub": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "routes": {
          "up": "FROM /messages/* INTO $upstream"
        },
        "storeAndForwardConfiguration": {
          "timeToLiveSecs": 7200
        }
      }
    }
  }
}
